# Copy to .env and set every value. .env is ignored by git, and the stack
# refuses to start while any of these is empty.
#
# Generate each one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs caller credentials. At least 32 bytes.
GUARDRAIL_JWT_SECRET=
# The database account's credential, and the same value inside the URL the
# gateway connects with: scheme postgresql, user gateway, host postgres,
# port 5432, database gateway.
POSTGRES_PASSWORD=
GUARDRAIL_DATABASE_URL=
CLICKHOUSE_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=

# Optional.
# GUARDRAIL_JWT_ISSUER=https://issuer.local
# GUARDRAIL_JWT_AUDIENCE=guardrail-gateway
# GATEWAY_PORT=8000
# GRAFANA_PORT=3000
