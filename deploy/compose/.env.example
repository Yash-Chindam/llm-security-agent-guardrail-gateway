# Copy to .env and set every value. .env is ignored by git.
#
# Generate each one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs caller credentials. At least 32 bytes.
GUARDRAIL_JWT_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional.
# GUARDRAIL_JWT_ISSUER=https://issuer.local
# GUARDRAIL_JWT_AUDIENCE=guardrail-gateway
# GATEWAY_PORT=8000
# GRAFANA_PORT=3000
