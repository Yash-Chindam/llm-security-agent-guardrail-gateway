{
  "uid": "guardrail-gateway",
  "title": "Guardrail Gateway",
  "tags": [
    "security",
    "llm"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Decisions by verdict",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (verdict) (rate(guardrail_decisions_total[5m]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Block rate by enforcement point",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (enforcement_point) (rate(guardrail_decisions_total{verdict=\"deny\"}[5m])) / sum by (enforcement_point) (rate(guardrail_decisions_total[5m]))",
          "legendFormat": "{{enforcement_point}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prompt-injection blocks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (enforcement_point) (rate(guardrail_decisions_total{reason_code=\"prompt_injection_detected\"}[5m]))",
          "legendFormat": "{{enforcement_point}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Denied actions by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason_code) (rate(guardrail_decisions_total{enforcement_point=\"action\",verdict=\"deny\"}[5m]))",
          "legendFormat": "{{reason_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Decision latency P50 / P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, enforcement_point) (rate(guardrail_decision_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{enforcement_point}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, enforcement_point) (rate(guardrail_decision_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{enforcement_point}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Detector latency P50 / P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, detector) (rate(guardrail_detector_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{detector}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, detector) (rate(guardrail_detector_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{detector}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Approvals by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (guardrail_approvals)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Approval expiry rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(guardrail_approvals{status=\"expired\"}) / clamp_min(sum(guardrail_approvals), 1)",
          "legendFormat": "expired",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Reviewer rejection rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(guardrail_approvals{status=\"rejected\"}) / clamp_min(sum(guardrail_approvals{status=~\"approved|consumed|rejected\"}), 1)",
          "legendFormat": "rejected",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Audit delivery: pending, in flight, dropped",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(guardrail_audit_events_pending)",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(guardrail_audit_events_in_flight)",
          "legendFormat": "in flight",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(guardrail_audit_events_dropped)",
          "legendFormat": "dropped",
          "refId": "C"
        }
      ]
    },
    {
      "id": 11,
      "title": "Fail-closed decisions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason_code) (rate(guardrail_decisions_total{reason_code=~\".*_unavailable\"}[5m]))",
          "legendFormat": "{{reason_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Credential rejections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason_code) (rate(guardrail_credential_rejections_total[5m]))",
          "legendFormat": "{{reason_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Open incidents",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(guardrail_incidents_open)",
          "legendFormat": "open",
          "refId": "A"
        }
      ]
    }
  ]
}
